# ============================================================
#  Monasterio de Cañas — .htaccess
#  Apache 2.4+ · HTTPS forzado, seguridad, caché y compresión
# ============================================================

# Codificación por defecto
AddDefaultCharset UTF-8

# Desactivar listado de directorios
Options -Indexes

# Página de inicio
DirectoryIndex index.html


# ============================================================
#  REWRITES — HTTPS + canonical + index.html → /
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2) Forzar dominio sin www  → monasteriodecanas.org
  RewriteCond %{HTTP_HOST} ^www\.monasteriodecanas\.org$ [NC]
  RewriteRule ^(.*)$ https://monasteriodecanas.org/$1 [R=301,L]

  # 3) Redirigir /index.html (y /index) a la raíz para evitar contenido duplicado
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # 4) Eliminar barra final en archivos (no afecta a directorios)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>


# ============================================================
#  SEGURIDAD — Bloquear archivos sensibles y ocultos
# ============================================================

# Bloquear todos los ficheros que empiecen por punto (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Bloquear acceso por URL a directorios ocultos del repositorio o herramientas
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /\.claude(/|$)
RedirectMatch 404 /\.vscode(/|$)
RedirectMatch 404 /\.idea(/|$)

# Bloquear archivos de configuración y backups
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|swo|orig|save)|~)$">
  Require all denied
</FilesMatch>

# Proteger explícitamente el propio .htaccess
<Files ".htaccess">
  Require all denied
</Files>


# ============================================================
#  CABECERAS DE SEGURIDAD (HTTPS + buenas prácticas)
# ============================================================
<IfModule mod_headers.c>
  # HSTS — fuerza HTTPS durante 2 años, incluyendo subdominios
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Anti-MIME-sniffing
  Header set X-Content-Type-Options "nosniff"

  # Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # XSS legacy (navegadores antiguos)
  Header set X-XSS-Protection "1; mode=block"

  # Política de referer
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permisos de APIs del navegador
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Cross-Origin
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Resource-Policy "same-origin"

  # Eliminar cabecera que expone tecnología del servidor
  Header unset X-Powered-By
  Header always unset Server
</IfModule>


# ============================================================
#  COMPRESIÓN — Brotli (si disponible) + Gzip fallback
# ============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>


# ============================================================
#  CACHÉ — Expiración por tipo de recurso
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                                "access plus 1 month"

  # HTML — 1 hora (cambia con frecuencia)
  ExpiresByType text/html                       "access plus 1 hour"

  # CSS, JS — 1 mes
  ExpiresByType text/css                        "access plus 1 month"
  ExpiresByType application/javascript          "access plus 1 month"
  ExpiresByType text/javascript                 "access plus 1 month"

  # Imágenes — 6 meses
  ExpiresByType image/webp                      "access plus 6 months"
  ExpiresByType image/png                       "access plus 6 months"
  ExpiresByType image/jpg                       "access plus 6 months"
  ExpiresByType image/jpeg                      "access plus 6 months"
  ExpiresByType image/gif                       "access plus 6 months"
  ExpiresByType image/svg+xml                   "access plus 6 months"
  ExpiresByType image/x-icon                    "access plus 1 year"

  # Vídeo — 6 meses
  ExpiresByType video/mp4                       "access plus 6 months"
  ExpiresByType video/webm                      "access plus 6 months"

  # Fuentes — 1 año
  ExpiresByType font/ttf                        "access plus 1 year"
  ExpiresByType font/otf                        "access plus 1 year"
  ExpiresByType font/woff                       "access plus 1 year"
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType application/font-woff           "access plus 1 year"
  ExpiresByType application/font-woff2          "access plus 1 year"

  # Manifest, RSS, XML
  ExpiresByType application/manifest+json       "access plus 1 week"
  ExpiresByType application/x-web-app-manifest+json "access plus 1 week"
  ExpiresByType application/rss+xml             "access plus 1 hour"
  ExpiresByType application/xml                 "access plus 1 hour"
  ExpiresByType text/xml                        "access plus 1 hour"
</IfModule>

# Cache-Control adicional con immutable para assets versionables
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>


# ============================================================
#  MIME TYPES — Asegurar que SVG, WebP, WebManifest, etc. sirven bien
# ============================================================
<IfModule mod_mime.c>
  AddType image/svg+xml                 .svg .svgz
  AddType image/webp                    .webp
  AddType application/manifest+json     .webmanifest
  AddType application/font-woff2        .woff2
  AddType application/font-woff         .woff
  AddType font/ttf                      .ttf
  AddType font/otf                      .otf
  AddType video/mp4                     .mp4
  AddType video/webm                    .webm
  AddCharset UTF-8                      .html .css .js .xml .json .webmanifest
</IfModule>


# ============================================================
#  ETAGS — desactivar (mejor usar Cache-Control + Expires)
# ============================================================
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None


# ============================================================
#  PÁGINAS DE ERROR
# ============================================================
ErrorDocument 404 /404.html
